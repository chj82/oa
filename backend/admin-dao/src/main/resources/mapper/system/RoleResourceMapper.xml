<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oa.dao.system.RoleResourceMapper">
    <insert id="insertBatch">
        INSERT INTO t_role_resource (role_id, resource_id, created_at)
        VALUES
        <foreach collection="relations" item="item" separator=",">
            (#{item.roleId}, #{item.resourceId}, #{item.createdAt})
        </foreach>
    </insert>
</mapper>
