<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oa.dao.system.EmployeeRoleMapper">
    <insert id="insertBatch">
        INSERT INTO t_employee_role (employee_id, role_id, created_at)
        VALUES
        <foreach collection="relations" item="item" separator=",">
            (#{item.employeeId}, #{item.roleId}, #{item.createdAt})
        </foreach>
    </insert>
</mapper>
